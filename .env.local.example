# =====================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
# =====================================================================

# --- Supabase (Project Settings -> API) ------------------------------
# Safe to expose: these ship to the browser. RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely.
# Never prefix with NEXT_PUBLIC_. Only ever imported by
# src/lib/supabase/admin.ts, which is marked "server-only".
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------
# Canonical origin for canonical tags, OG images and sitemap.xml.
# Leave unset on Vercel previews and NEXT_PUBLIC_VERCEL_URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Inquiries -------------------------------------------------------
# Random 32+ byte string. Salts the SHA-256 of inquirer IPs so the
# rate limiter works without ever storing a raw IP address.
# Generate: openssl rand -hex 32
INQUIRY_IP_SALT=

# --- E-mail (OPTIONAL) -----------------------------------------------
# Without these, inquiries still save and appear in /dashboard/upiti —
# only the notification e-mail is skipped. Nothing breaks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Tooling (optional) ----------------------------------------------
# Used by `npm run types:db` to regenerate src/types/database.ts.
SUPABASE_PROJECT_ID=
